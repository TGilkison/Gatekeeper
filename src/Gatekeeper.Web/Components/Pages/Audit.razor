@page "/audit"
@using Microsoft.EntityFrameworkCore
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IDbContextFactory<GatekeeperDbContext> DbFactory

<PageTitle>Gatekeeper · Audit Log</PageTitle>

<h1>Audit Log</h1>
<p class="text-muted">Every change made through the console: who, what, and when. Newest first.</p>

<div class="row g-2 mb-3">
    <div class="col-md-3">
        <input class="form-control" placeholder="Filter by entity type…" @bind="entityFilter" @bind:event="oninput" />
    </div>
    <div class="col-md-3">
        <input class="form-control" placeholder="Filter by actor…" @bind="actorFilter" @bind:event="oninput" />
    </div>
</div>

@if (entries is null)
{
    <p><em>Loading…</em></p>
}
else
{
    var view = entries
        .Where(e => string.IsNullOrWhiteSpace(entityFilter) || e.EntityType.Contains(entityFilter, StringComparison.OrdinalIgnoreCase))
        .Where(e => string.IsNullOrWhiteSpace(actorFilter) || e.ActorName.Contains(actorFilter, StringComparison.OrdinalIgnoreCase))
        .ToList();

    <p class="text-muted">@view.Count of @entries.Count entries</p>
    <table class="table table-striped table-sm align-middle">
        <thead>
            <tr><th>When</th><th>Actor</th><th>Action</th><th>Entity</th><th>Summary</th></tr>
        </thead>
        <tbody>
            @foreach (var e in view)
            {
                <tr>
                    <td class="text-nowrap">@e.Timestamp.LocalDateTime.ToString("g")</td>
                    <td>@e.ActorName</td>
                    <td><span class="badge @ActionBadge(e.Action)">@e.Action</span></td>
                    <td>@e.EntityType</td>
                    <td>@e.Summary</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<AuditLogEntry>? entries;
    private string entityFilter = string.Empty;
    private string actorFilter = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        entries = await db.AuditLog
            .OrderByDescending(e => e.Timestamp)
            .Take(500)
            .ToListAsync();
    }

    private static string ActionBadge(string action) => action switch
    {
        "Created" => "bg-success",
        "Updated" => "bg-primary",
        "Deleted" => "bg-danger",
        _ => "bg-secondary",
    };
}
